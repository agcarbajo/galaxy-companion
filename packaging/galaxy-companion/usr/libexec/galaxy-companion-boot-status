#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
"""Report which system the boot partitions currently hold.

Reading a block device needs root, so this runs through polkit — but only to
read, which is why its action is allowed without a password while switching
asks for one.
"""

import json
import sys
from pathlib import Path

# Installed: /usr/libexec next to /usr/lib/galaxy-companion; same from a checkout.
sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "lib" / "galaxy-companion"))

from galaxy_companion import boot_core  # noqa: E402


def main():
    print(json.dumps(boot_core.status()))
    return 0


if __name__ == "__main__":
    sys.exit(main())
