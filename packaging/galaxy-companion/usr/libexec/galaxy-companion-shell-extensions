#!/usr/bin/python3
# SPDX-License-Identifier: MIT
"""record-crash | recover | restart: see galaxy_companion/shell_extensions.py."""
import json
import sys
from pathlib import Path

from gi.repository import GLib

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "lib" / "galaxy-companion"))
from galaxy_companion import shell_extensions  # noqa: E402


def main(argv):
    if len(argv) != 2 or argv[1] not in ("record-crash", "recover", "restart"):
        print("usage: galaxy-companion-shell-extensions record-crash|recover|restart", file=sys.stderr)
        return 2
    store = shell_extensions.settings()
    if store is None:
        return 0    # Not a GNOME Shell desktop: nothing to look after.
    try:
        if argv[1] == "record-crash":
            shell_extensions.record_crash(store)
        elif argv[1] == "recover":
            print(shell_extensions.recover(store))
        else:
            print(json.dumps(shell_extensions.restart(store)))
    except (GLib.Error, OSError) as error:
        print(error, file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
