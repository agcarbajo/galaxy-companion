<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>

  <vendor>Galaxy Companion</vendor>
  <vendor_url>https://github.com/agcarbajo/galaxy-companion</vendor_url>

  <!-- Reading the boot partitions decides what the window shows, so it runs on
       every open.  It changes nothing, so it does not deserve a password
       prompt; the switch below is the one that does. -->
  <action id="io.github.agcarbajo.GalaxyCompanion.boot-status">
    <description>Read which system the device will boot</description>
    <description xml:lang="es">Leer qué sistema arrancará el dispositivo</description>
    <message>Authentication is required to read the boot partitions</message>
    <message xml:lang="es">Se necesita autenticación para leer las particiones de arranque</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/galaxy-companion-boot-status</annotate>
  </action>

  <action id="io.github.agcarbajo.GalaxyCompanion.boot-switch">
    <description>Change which system the device boots</description>
    <description xml:lang="es">Cambiar el sistema que arranca el dispositivo</description>
    <message>Authentication is required to change the system the device boots</message>
    <message xml:lang="es">Se necesita autenticación para cambiar el sistema que arranca el dispositivo</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/galaxy-companion-boot-switch</annotate>
  </action>

</policyconfig>
