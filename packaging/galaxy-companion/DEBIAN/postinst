#!/bin/sh
set -e

# Reproducible packages normalize source mtimes. A same-size edit can otherwise
# leave a timestamp-based cache from an older release looking valid to Python.
if command -v py3clean >/dev/null 2>&1; then
	py3clean -p galaxy-companion
fi
if command -v py3compile >/dev/null 2>&1; then
	py3compile -p galaxy-companion
fi

if command -v glib-compile-schemas >/dev/null 2>&1; then
	glib-compile-schemas /usr/share/glib-2.0/schemas
fi

if command -v udevadm >/dev/null 2>&1 && [ -e /dev/uinput ]; then
	udevadm trigger --action=change --name-match=uinput || true
	udevadm trigger --action=change --subsystem-match=i2c || true
	udevadm settle || true
fi

# Tab Companion kept the S Pen remote switch here before the rename.
if [ -e /var/lib/tab-companion/spen-remote-enabled ] && [ ! -e /var/lib/galaxy-companion/spen-remote-enabled ]; then
	mkdir -p /var/lib/galaxy-companion
	cp -p /var/lib/tab-companion/spen-remote-enabled /var/lib/galaxy-companion/spen-remote-enabled
fi

# A "switch without the password" rule written by Tab Companion names its
# polkit action; polkit would keep loading it and never match it.
for rule in /etc/polkit-1/rules.d/*.rules; do
	[ -f "$rule" ] || continue
	if grep -q 'io.github.agcarbajo.TabCompanion.boot-switch' "$rule"; then
		sed -i 's/io\.github\.agcarbajo\.TabCompanion\.boot-switch/io.github.agcarbajo.GalaxyCompanion.boot-switch/' "$rule"
	fi
done

if command -v systemctl >/dev/null 2>&1; then
	# Units from Tab Companion: its files are gone once this package replaces
	# it, but the enablement symlinks would linger and point at nothing.
	systemctl disable tab-companion-spen-pairing.service >/dev/null 2>&1 || true
	systemctl --global disable tab-companion-haptics-enable.service >/dev/null 2>&1 || true
	systemctl --global disable tab-companion-update-check.timer >/dev/null 2>&1 || true
	systemctl daemon-reload
	systemctl reload dbus.service >/dev/null 2>&1 || true
	systemctl enable galaxy-companion-spen-pairing.service >/dev/null 2>&1 || true
	systemctl restart galaxy-companion-spen-pairing.service || true
	systemctl enable galaxy-companion-charge-limit.service >/dev/null 2>&1 || true
	# Enabled, not started: it saves the boot partitions as they are at boot,
	# and in the middle of an upgrade they may already hold a newer kernel.
	systemctl enable galaxy-companion-boot-capture.service >/dev/null 2>&1 || true
	systemctl restart galaxy-companion-charge-limit.service || true
	systemctl --global enable galaxy-companion-haptics-enable.service >/dev/null 2>&1 || true
	systemctl --global enable galaxy-companion-update-check.timer >/dev/null 2>&1 || true
fi

# The dual boot quick settings entry ships enabled, but it is NOT seeded from
# here.  A dconf default for org.gnome.shell enabled-extensions replaces the
# whole list rather than adding to it, which would silently switch off
# ubuntu-dock and the desktop icons for every fresh account.  The app appends
# itself to whatever the user already has, once, on first run.

exit 0
